{
  "name": "Journal de tir",
  "short_name": "Journal tir",
  "description": "Journal de tir hors ligne : séries, chrono, alertes, calculateur.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1C2129",
  "theme_color": "#14181F",
  "lang": "fr",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            ".csv",
            ".fit",
            "text/csv",
            "text/comma-separated-values",
            "text/plain",
            "application/octet-stream",
            "application/vnd.ms-excel"
          ]
        }
      ]
    }
  }
}